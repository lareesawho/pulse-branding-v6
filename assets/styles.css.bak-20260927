/* keep in-page anchors clear of the fixed header */
html{scroll-padding-top:104px}
[id]{scroll-margin-top:104px}

/* Self-hosted brand typography (latin subset, variable weights) */
@font-face{font-family:'Montserrat';font-style:normal;font-weight:300 700;font-display:swap;src:url('fonts/montserrat-normal-300-700.woff2') format('woff2')}
@font-face{font-family:'Montserrat';font-style:italic;font-weight:300 700;font-display:swap;src:url('fonts/montserrat-italic-300-700.woff2') format('woff2')}
@font-face{font-family:'Inter';font-style:normal;font-weight:300 700;font-display:swap;src:url('fonts/inter-normal-300-700.woff2') format('woff2')}
@font-face{font-family:'Inter';font-style:italic;font-weight:300 700;font-display:swap;src:url('fonts/inter-italic-300-700.woff2') format('woff2')}
@font-face{font-family:'Noto Serif Display';font-style:normal;font-weight:300 500;font-display:swap;src:url('fonts/notoserifdisplay-normal-300-500.woff2') format('woff2')}
@font-face{font-family:'Noto Serif Display';font-style:italic;font-weight:300 500;font-display:swap;src:url('fonts/notoserifdisplay-italic-300-500.woff2') format('woff2')}


/* =========================================================
   PULSE SPACING SYSTEM — LOCKED
   Do not invent one-off margin/padding values in page markup.
   Use these tokens only.
   ========================================================= */
:root{
  --sp-0:4px; /* optical half-step */
  --sp-1:8px;
  --sp-2:16px;
  --sp-3:24px;
  --sp-4:32px;
  --sp-5:48px;
  --sp-6:64px;
  --sp-7:96px;
  --sp-8:128px;

  --section-y:clamp(80px,8vw,128px);
  --section-y-tight:clamp(56px,6vw,88px);
  --content-gap:clamp(40px,6vw,96px);
  --grid-gap:clamp(18px,2vw,28px);
}

/* canonical vertical rhythm */
.section{padding:var(--section-y) 0}
.section-tight{padding:var(--section-y-tight) 0}
.kicker{margin-bottom:var(--sp-3)}
.stack-xs>*+*{margin-top:var(--sp-1)}
.stack-sm>*+*{margin-top:var(--sp-2)}
.stack-md>*+*{margin-top:var(--sp-3)}
.stack-lg>*+*{margin-top:var(--sp-5)}
.stack-xl>*+*{margin-top:var(--sp-7)}
.mt-1{margin-top:var(--sp-1)!important}
.mt-2{margin-top:var(--sp-2)!important}
.mt-3{margin-top:var(--sp-3)!important}
.mt-4{margin-top:var(--sp-4)!important}
.mt-5{margin-top:var(--sp-5)!important}
.mt-6{margin-top:var(--sp-6)!important}
.mb-0{margin-bottom:0!important}

/* shared grid spacing */
.grid-2{gap:var(--content-gap)}
.project-grid,.agent-grid,.tile-grid,.insight-grid,.choice-grid{gap:var(--grid-gap)}

/* responsive spacing contract */
@media(max-width:900px){
  :root{
    --section-y:80px;
    --section-y-tight:56px;
    --content-gap:40px;
    --grid-gap:16px;
  }
}
@media(max-width:620px){
  :root{
    --section-y:64px;
    --section-y-tight:48px;
    --content-gap:28px;
    --grid-gap:14px;
  }
}


:root{
  --navy:#0a1931;
  --stone:#d7dfdf;
  --navy-2:#071321;
  --ice:#e1eef0;
  --paper:#f0f4f4;
  --paper-2:#e8eeee;
  --violet:#291c53;
  --blue:#2163af;
  --aqua:#2ea8ae;
  --ink:#111c29;
  --muted:#5b666c;
  --line:rgba(10,25,49,.13);
  --line-dark:rgba(225,238,240,.14);
  --shell:1440px;
  --gutter:clamp(18px,3.2vw,56px);
  --section:clamp(76px,8vw,132px);
  --radius:4px;
  --ease:cubic-bezier(.16,1,.3,1);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Montserrat,Inter,"Helvetica Neue",Arial,sans-serif;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
img,video,canvas{max-width:100%;display:block}
.shell{width:calc(100% - var(--gutter) - var(--gutter));max-width:var(--shell);margin-inline:auto}
.section{padding:var(--section-y) 0}
.section-tight{padding:var(--section-y-tight) 0}
.stone{background:var(--stone)}

/* Stone band: the mid greys tuned for the lightest background go soft here, so the
   band carries its own ink and rule weights. */
.stone .copy,.stone p,.stone li{color:#3d484e}
.stone .eyebrow,.stone .muted{color:#4f5b63}
.stone .eyebrow.muted{color:#4f5b63}
.stone .label,.stone .meta,.stone .meta-row span{color:#4a565d}
.stone .service-row .desc,.stone .faq-item p{color:#3d484e}
.stone .service-row .num,.stone .rich-item .num{color:#3d484e}

.stone .rule,.stone .hairline{border-color:rgba(10,25,49,.16)}
.stone .lead{color:#33404a}
.dark{background:var(--navy);color:var(--ice)}
.violet{background:var(--violet);color:var(--ice)}
.eyebrow{
  font-size:11.5px;letter-spacing:.15em;text-transform:uppercase;font-weight:600;
}
.eyebrow.muted,.muted{color:var(--muted)}
.dark .muted,.violet .muted{color:rgba(225,238,240,.8)}
.serif{
  font-family:"Noto Serif Display",Georgia,"Times New Roman",serif;
  font-style:italic;font-weight:400
}
/* Headline rule: the sans line and the serif-accent line each hold one row. */
.display .serif,.h1 .serif,.h2 .serif{display:block}
h1,h2,h3,p{margin-top:0}
.display{
  font-size:clamp(38px,4.6vw,74px);
  line-height:.98;letter-spacing:-.045em;font-weight:500;margin:0
}
.h1{
  font-size:clamp(34px,4vw,62px);
  line-height:1;letter-spacing:-.04em;font-weight:500;margin:0
}
.h2{
  font-size:clamp(26px,2.6vw,42px);
  line-height:1.08;letter-spacing:-.028em;font-weight:500;margin:0
}
.h3{
  font-size:clamp(19px,1.7vw,27px);
  line-height:1.14;letter-spacing:-.02em;font-weight:500;margin:0
}
.lead{
  font-size:clamp(18px,1.7vw,25px);
  line-height:1.48;letter-spacing:-.015em
}
.copy{font-size:15px;line-height:1.7;color:var(--muted)}
.dark .copy,.violet .copy{color:rgba(225,238,240,.8)}
.rule{border-top:1px solid var(--line)}
.dark .rule{border-color:var(--line-dark)}
.kicker{margin-bottom:var(--sp-3)}
.link{
  display:inline-flex;align-items:center;gap:var(--sp-1);
  font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  padding-bottom:var(--sp-1);border-bottom:1px solid currentColor;
}
.grid-2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--content-gap)}
.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line)}
.grid-4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line)}
.cell{background:var(--paper);padding:clamp(var(--sp-3),3vw,var(--sp-5))}
.dark .cell{background:var(--navy)}
.sticky{position:sticky;top:116px;align-self:start}

/* NAV */
.nav{
  position:fixed;inset:0 0 auto;z-index:1000;
  color:var(--ice);
  background:linear-gradient(to bottom,rgba(7,19,33,.84),rgba(7,19,33,.36),transparent);
  transition:.5s var(--ease);
}
.nav.scrolled{
  background:rgba(7,19,33,.88);backdrop-filter:blur(16px);
  border-bottom:1px solid rgba(225,238,240,.08)
}
.nav-inner{
  height:82px;display:grid;grid-template-columns:1fr auto 1fr;
  align-items:center;gap:24px
}
.logo{display:inline-flex;align-items:center;min-height:44px}
.logo img{height:24px;width:auto;max-width:165px;filter:brightness(0) invert(1)}
.nav-links{display:flex;gap:var(--sp-3);font-size:12px}
.nav-links a,.nav-end a{display:inline-flex;align-items:center;min-height:44px}
.nav-end{justify-self:end;display:flex;gap:16px;align-items:center;font-size:11px}
.mobile-menu{display:none;background:none;border:0;color:var(--ice);font-size:13px;min-height:44px;min-width:44px;padding:var(--sp-1) var(--sp-1);align-items:center;justify-content:center}
.mobile-panel{
  display:none;position:fixed;top:68px;left:0;right:0;background:rgba(7,19,33,.98);
  color:var(--ice);padding:24px var(--gutter) var(--sp-4);border-bottom:1px solid var(--line-dark)
}
.mobile-panel.open{display:block}
.mobile-panel a{display:flex;align-items:center;min-height:48px;padding:var(--sp-1) 0;border-bottom:1px solid var(--line-dark)}

/* BORDER GLOW */
@property --glow-angle{syntax:"<angle>";inherits:false;initial-value:0deg}
.glow{
  position:relative;isolation:isolate;border:1px solid rgba(225,238,240,.16);
  background:rgba(10,25,49,.25)
}
.glow:after{
  content:"";position:absolute;inset:-1px;pointer-events:none;padding:1px;
  background:conic-gradient(from var(--glow-angle),transparent 0 18%,rgba(46,168,174,.95) 24%,rgba(33,99,175,.78) 31%,rgba(41,28,83,.75) 38%,transparent 46% 100%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  animation:glowSweep 6s linear infinite
}
@keyframes glowSweep{to{--glow-angle:360deg}}

/* HERO */
.hero{
  min-height:100svh;background:var(--navy);color:var(--ice);
  position:relative;overflow:hidden;display:flex;align-items:flex-end
}
.hero-grid{
  position:relative;z-index:2;
  padding:clamp(136px,15vh,190px) 0 clamp(42px,6vh,var(--sp-6));
  display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);
  gap:clamp(48px,7vw,120px);align-items:end
}
.hero-copy .lead{max-width:700px;color:rgba(225,238,240,.82);margin:var(--sp-3) 0 0}
.hero-note{color:rgba(225,238,240,.78);max-width:680px}
.service-hero .lead{color:rgba(225,238,240,.82)}
.hero .eyebrow{color:rgba(225,238,240,.82)}
.hero .muted,.service-hero .muted,.case-hero .muted{color:rgba(225,238,240,.82)}
.hero-meta{border-top:1px solid var(--line-dark)}
.meta-row{
  display:grid;grid-template-columns:104px 1fr;gap:var(--sp-2);
  padding:var(--sp-2) 0;border-bottom:1px solid var(--line-dark);
  font-size:11.5px;color:rgba(225,238,240,.76)
}
.meta-row strong{color:var(--ice);font-weight:500;font-size:12px}
.hero-actions{display:flex;gap:var(--sp-2);align-items:center;margin-top:var(--sp-4);flex-wrap:wrap}
.hero-actions .btn,.hero-actions .link{display:inline-flex;align-items:center;min-height:44px}
.hero-actions .btn,.hero-actions .link{display:inline-flex;align-items:center;min-height:44px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  min-height:46px;padding:0 var(--sp-2);border:1px solid currentColor;background:none;
  color:inherit;font-size:10px;letter-spacing:.12em;text-transform:uppercase;
}
.btn-dark{background:var(--navy);color:var(--ice);border-color:var(--navy)}
.btn-light{background:var(--ice);color:var(--navy);border-color:var(--ice)}

/* STATEMENT */
.statement{border-top:1px solid rgba(225,238,240,.16);border-bottom:1px solid rgba(225,238,240,.16);background:#0d2444;color:var(--ice)}  /* a shade off the hero so it reads as its own band */
.statement-row{display:grid;grid-template-columns:repeat(4,1fr);gap:0;counter-reset:statement}
.statement-row div{
  counter-increment:statement;display:flex;align-items:center;gap:var(--sp-1);
  padding:var(--sp-3) var(--sp-2);border-right:1px solid rgba(225,238,240,.16);
  font-size:13px;font-weight:500;letter-spacing:-.005em;color:rgba(236,244,247,.94)
}
.statement-row div:before{
  content:"0" counter(statement);font-size:11px;font-weight:700;letter-spacing:.1em;
  color:var(--blue);flex:0 0 auto;padding-top:1px
}
.statement-row div:first-child{padding-left:0}.statement-row div:last-child{border-right:0}

/* SERVICE LIST */
.service-layout{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(var(--sp-5),8vw,130px)}
.service-list{border-top:1px solid var(--line)}
.service-row{
  display:grid;grid-template-columns:44px 1fr 22px;gap:16px;align-items:start;
  padding:var(--sp-3) 0;border-bottom:1px solid var(--line);
  transition:padding .45s var(--ease),color .45s var(--ease)
}
.service-row:hover{padding-left:var(--sp-1);color:var(--blue)}
.service-row .num{font-size:11px;color:#68747a;padding-top:8px}
.service-row .desc{font-size:13px;color:var(--muted);margin-top:var(--sp-1);max-width:54ch}

/* PROJECTS */
.project-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--sp-2)}
.project-card{
  position:relative;min-height:520px;overflow:hidden;background:var(--navy);color:var(--ice);
  border:1px solid rgba(225,238,240,.09)
}
.project-card.large{grid-column:span 8}.project-card.small{grid-column:span 4}
.project-card:before{
  content:"";position:absolute;inset:-10%;
  background:radial-gradient(circle at 70% 24%,rgba(46,168,174,.25),transparent 27%),
             radial-gradient(circle at 32% 76%,rgba(41,28,83,.82),transparent 46%),
             linear-gradient(135deg,#0a1931,#102b46 52%,#291c53);
  transition:transform 1.2s var(--ease)
}
.project-card:nth-child(2):before{
  background:radial-gradient(circle at 26% 24%,rgba(33,99,175,.35),transparent 30%),
             linear-gradient(145deg,#071321,#291c53 70%)
}
.project-card:hover:before{transform:scale(1.07)}
.project-content{
  position:absolute;inset:auto 30px 28px;z-index:2;
  display:flex;justify-content:space-between;gap:var(--sp-4);align-items:end
}
.project-content p{font-size:13px;color:rgba(225,238,240,.78);max-width:420px;margin:var(--sp-1) 0 0}

/* WHY / PROCESS */
.process-wrap{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(var(--sp-5),8vw,120px)}
.process-visual{
  min-height:540px;background:var(--navy);position:relative;overflow:hidden;border:1px solid var(--line-dark)
}
.process-visual:before{
  content:"";position:absolute;inset:-15%;
  background:
    radial-gradient(circle at 50% 50%,rgba(46,168,174,.18),transparent 15%),
    repeating-radial-gradient(circle at 50% 50%,transparent 0 9%,rgba(33,99,175,.18) 9.2% 9.5%,transparent 9.8% 14%);
  animation:processBreath 10s ease-in-out infinite alternate
}
@keyframes processBreath{to{transform:scale(1.12) rotate(4deg)}}
.process-list{border-top:1px solid var(--line)}
.process-item{padding:var(--sp-3) 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:42px 1fr;gap:16px}
.process-item span{font-size:11px;color:#68747a;padding-top:var(--sp-0)}
.process-item strong{display:block;font-weight:500;font-size:18px}
.process-item p{font-size:13px;color:var(--muted);margin:var(--sp-1) 0 0}

/* STEPPER */
.stepper{
  display:grid;grid-template-columns:220px 1fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:48px
}
.step-list{padding:16px var(--sp-3) 16px 0;border-right:1px solid var(--line)}
.step-btn{
  width:100%;display:grid;grid-template-columns:30px 1fr;gap:var(--sp-1);background:none;border:0;
  border-bottom:1px solid rgba(10,25,49,.08);padding:var(--sp-2) 0;text-align:left;color:var(--ink);
  transition:.4s var(--ease)
}
.step-btn:last-child{border-bottom:0}.step-btn.active{padding-left:var(--sp-1);color:var(--blue)}
.step-btn .n{font-size:10px;color:#66737a;padding-top:var(--sp-0)}.step-btn strong{font-weight:500;font-size:14px}
.step-content{padding:var(--sp-5) 0 var(--sp-5) var(--sp-5);min-height:310px;display:flex;align-items:center}
.step-panel{display:none;max-width:700px}.step-panel.active{display:block;animation:stepIn .65s var(--ease)}
.step-panel p{color:var(--muted);line-height:1.65;max-width:620px}
@keyframes stepIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* SERVICE HERO MOTION */
.service-hero{
  min-height:76svh;background:var(--navy);color:var(--ice);position:relative;overflow:hidden;
  display:flex;align-items:flex-end
}
.neural{position:absolute;inset:0;overflow:hidden}
.neural:before{
  content:"";position:absolute;inset:-20%;
  background:radial-gradient(circle at 25% 36%,rgba(46,168,174,.12),transparent 24%),
             radial-gradient(circle at 74% 62%,rgba(33,99,175,.18),transparent 28%),
             radial-gradient(circle at 48% 78%,rgba(41,28,83,.28),transparent 34%);
  filter:blur(32px);animation:chroma 15s ease-in-out infinite alternate
}
@keyframes chroma{to{transform:translate3d(4%,-2%,0) scale(1.08)}}
.flash{position:absolute;height:1px;background:linear-gradient(90deg,transparent,rgba(46,168,174,.0),rgba(46,168,174,.95),rgba(225,238,240,.12),transparent);box-shadow:0 0 20px rgba(46,168,174,.35);opacity:.08;animation:flash 7s var(--ease) infinite}
.flash.f1{width:42%;left:8%;top:34%}.flash.f2{width:36%;left:48%;top:56%;animation-delay:2.1s;transform:rotate(-8deg)}.flash.f3{width:29%;left:18%;top:72%;animation-delay:4.2s;transform:rotate(11deg)}
@keyframes flash{0%,78%,100%{opacity:.05;scale:.25 1}86%{opacity:1;scale:1 1}94%{opacity:.15;scale:.7 1}}
.service-hero-grid{
  position:relative;z-index:2;padding:150px 0 var(--sp-6);
  display:grid;grid-template-columns:1.15fr .85fr;gap:8vw;align-items:end
}

/* LINE SIDEBAR */
.longform-grid{display:grid;grid-template-columns:160px 1fr;gap:clamp(var(--sp-4),7vw,110px)}
.line-side{position:sticky;top:118px;align-self:start;border-left:1px solid var(--line);padding-left:16px}
.line-side a{display:inline-flex;align-items:center;min-height:36px;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:#5f6b71;padding:var(--sp-0) 0}
.line-side a:hover{color:var(--blue)}
.article-section{padding:var(--sp-5) 0;border-top:1px solid var(--line)}
.article-section:first-child{border-top:0;padding-top:0}
.article-section .copy{max-width:780px}

/* CASE SCROLL EXPAND */
.case-hero{min-height:82svh;background:var(--navy);color:var(--ice);display:flex;align-items:flex-end}
.case-hero-grid{padding:150px 0 var(--sp-5);display:grid;grid-template-columns:1.15fr .85fr;gap:8vw;align-items:end}

/* AI CONSULTING */
.agent-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-2)}
.agent-card{
  min-height:410px;background:var(--navy);color:var(--ice);padding:var(--sp-4);
  display:flex;flex-direction:column;justify-content:space-between;overflow:hidden
}
.agent-card .orb{width:72px;height:72px;border-radius:50%;border:1px solid rgba(225,238,240,.18);display:grid;place-items:center}
.agent-card .orb:before{content:"";width:10px;height:10px;border-radius:50%;background:var(--aqua);box-shadow:0 0 26px rgba(46,168,174,.8)}
.agent-card p{font-size:13.5px;color:rgba(225,238,240,.78);line-height:1.6}
.demo-stage{
  margin-top:var(--sp-5);display:grid;grid-template-columns:.85fr 1.15fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line)
}
.demo-nav{padding:var(--sp-4) var(--sp-4) var(--sp-4) 0;border-right:1px solid var(--line)}
.demo-btn{
  width:100%;background:none;border:0;border-bottom:1px solid var(--line);
  padding:var(--sp-2) 0;text-align:left;font-size:15px;color:var(--ink)
}
.demo-btn.active{color:var(--blue);padding-left:8px}
.demo-panel{padding:var(--sp-4)}
.chat{display:flex;flex-direction:column;gap:var(--sp-2)}.msg{max-width:80%;padding:var(--sp-2) 16px;border:1px solid var(--line);font-size:13px;line-height:1.5}.msg.user{align-self:flex-end;background:var(--navy);color:var(--ice);border-color:var(--navy)}

/* AUDIT / PROPOSAL */
.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sp-2);margin-top:var(--sp-4)}
.choice-card{padding:var(--sp-4);border:1px solid var(--line);background:rgba(255,255,255,.24);min-height:260px;display:flex;flex-direction:column;justify-content:space-between}
.scope-shell{min-height:100svh;display:grid;grid-template-columns:.78fr 1.22fr}
.scope-left{background:var(--navy);color:var(--ice);padding:clamp(32px,5vw,var(--sp-6));display:flex;flex-direction:column;justify-content:space-between}
.scope-right{padding:clamp(var(--sp-4),6vw,var(--sp-7));display:flex;align-items:center}
.scope-panel{width:min(760px,100%);margin:auto}
.scope-step{display:none}.scope-step.active{display:block}
.option-list{border-top:1px solid var(--line)}
.option{
  width:100%;border:0;border-bottom:1px solid var(--line);background:none;
  display:grid;grid-template-columns:34px 1fr auto;gap:var(--sp-1);padding:var(--sp-2) 0;text-align:left;color:var(--ink)
}
.option:hover{padding-left:8px}
.field{width:100%;border:0;border-bottom:1px solid var(--ink);background:transparent;padding:var(--sp-2) 0;font-size:20px;outline:none}

/* SECTORS / INSIGHTS */
.tile-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sp-2)}
.tile{min-height:330px;border:1px solid var(--line);padding:var(--sp-4);display:flex;flex-direction:column;justify-content:space-between}
.tile:hover{background:var(--paper-2)}
.insight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-2)}
.insight{border-top:1px solid var(--line);padding-top:var(--sp-2);min-height:250px}

/* FOOTER */
.footer{background:#06111f;color:var(--ice);padding:var(--sp-6) 0 var(--sp-3)}
.footer-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--sp-6);align-items:end}
.footer img{height:28px;width:auto;filter:brightness(0) invert(1)}
.footer-links{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sp-0) var(--sp-4);font-size:12px;color:rgba(225,238,240,.8)}
.footer-links a{display:inline-flex;align-items:center;min-height:40px}
.footer-bottom{border-top:1px solid var(--line-dark);margin-top:var(--sp-5);padding-top:var(--sp-2);display:flex;justify-content:space-between;font-size:11px;color:rgba(225,238,240,.66)}

@media(max-width:1100px){
  .nav-links{gap:var(--sp-2)}
  .hero-grid,.service-hero-grid,.case-hero-grid{grid-template-columns:1fr .65fr}
  .service-layout,.process-wrap{grid-template-columns:1fr 1fr}
  .agent-grid{grid-template-columns:1fr}
}
@media(max-width:900px){
  .hero{min-height:88svh}
  .hero-grid,.service-hero-grid,.case-hero-grid,.grid-2,.service-layout,.process-wrap,.demo-stage,.footer-grid,.scope-shell{grid-template-columns:1fr}
  .hero-grid{padding-top:126px;gap:34px}
  .hero-meta{display:none}
  .statement-row{grid-template-columns:repeat(2,1fr)}
  .statement-row div:nth-child(2){border-right:0}.statement-row div:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .project-card.large,.project-card.small{grid-column:span 12}
  .grid-3,.grid-4{grid-template-columns:1fr 1fr}
  .stepper{grid-template-columns:1fr}
  .step-list{border-right:0;border-bottom:1px solid var(--line);padding:8px 0;display:grid;grid-template-columns:repeat(5,132px);overflow-x:auto}
  .step-btn{grid-template-columns:1fr;border-bottom:0;border-right:1px solid var(--line);padding:var(--sp-2) var(--sp-1)}
  .step-content{padding:var(--sp-4) 0;min-height:250px}
  .longform-grid{grid-template-columns:1fr}.line-side{display:none}
  .agent-grid{grid-template-columns:1fr}
  .scope-left{min-height:42svh}
  .tile-grid,.choice-grid{grid-template-columns:1fr}
  .insight-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
  :root{--gutter:16px;--section:70px}



  .hero-grid,.service-hero-grid,.case-hero-grid{padding-top:112px;padding-bottom:36px}
  .hero-actions{align-items:stretch;flex-direction:column}.hero-actions .btn,.hero-actions .link{width:100%}
  .statement-row{grid-template-columns:1fr}.statement-row div{border-right:0!important;border-bottom:1px solid var(--line)!important;padding-left:0}
  .grid-3,.grid-4{grid-template-columns:1fr}
  .project-card{min-height:430px}
  .project-content{left:20px;right:20px;bottom:22px;display:block}
  .process-visual{min-height:390px}
  .demo-nav{border-right:0;border-bottom:1px solid var(--line);padding-right:0}
  .demo-panel{padding:var(--sp-3) 0}
  .scope-right{padding:var(--sp-4) var(--sp-2)}
  .footer-links{grid-template-columns:1fr}.footer-bottom{display:block;line-height:1.8}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{animation-duration:.001ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}
}


/* =========================================================
   RESPONSIVE LAYOUT QA FIXES
   ========================================================= */

/* Never let the content shell touch the viewport edge. */
.shell{
  width:calc(100% - var(--gutter) - var(--gutter));
  max-width:var(--shell);
  margin-inline:auto;
}

/* Hero / navigation breathing room — the hero grids ARE shells, so they keep the
   page gutter instead of running full-bleed (desktop alignment fix). */
.nav-inner{padding-inline:0}
.hero-grid,
.service-hero-grid,
.case-hero-grid{
  width:calc(100% - var(--gutter) - var(--gutter));
  max-width:var(--shell);
  margin-inline:auto;
}

/* Keep hero typography from overfilling its column. */
.hero-copy{max-width:920px}
.hero-copy .display{max-width:none}
.service-hero-grid>div:first-child,
.case-hero-grid>div:first-child{max-width:940px}

/* Prevent metadata / supporting columns from crowding the edge. */
.hero-meta{min-width:0}
.hero-meta,.service-hero-grid>p,.case-hero-grid>div:last-child{
  max-width:620px;
  justify-self:end;
}

/* Consistent section heading rhythm */
.section .eyebrow + .h2,
.section .eyebrow + h2,
.section .eyebrow + .h3,
.section .eyebrow + h3{
  margin-top:var(--sp-3);
}

/* Footer rhythm */
.footer .h3{margin-top:var(--sp-4)}
.footer-grid{gap:var(--content-gap)}

/* Forms / scope controls */
.form-group + .form-group{margin-top:var(--sp-4)}
.scope-actions{
  display:flex;
  gap:var(--sp-2);
  margin-top:var(--sp-4);
  flex-wrap:wrap;
}

/* Desktop spacing: stronger visible frame around hero content. */
@media(min-width:901px){
  .hero-grid{padding-top:clamp(150px,16vh,210px);padding-bottom:clamp(64px,8vh,96px)}
  .service-hero-grid,.case-hero-grid{
    padding-top:clamp(150px,15vh,190px);
    padding-bottom:clamp(var(--sp-5),7vh,var(--sp-7));
  }
}

/* Tablet */
@media(max-width:1100px) and (min-width:901px){
  :root{--gutter:clamp(32px,4vw,46px)}
  .hero-grid,.service-hero-grid,.case-hero-grid{gap:var(--sp-6)}
}

/* Mobile / tablet composition */
@media(max-width:900px){
  :root{--gutter:24px}
  .shell{width:calc(100% - var(--gutter) - var(--gutter))}
  .hero-grid,.service-hero-grid,.case-hero-grid{
    padding-top:116px;
    padding-bottom:var(--sp-6);
    gap:var(--sp-4);
  }
  .hero-copy .display{max-width:none}
  .hero-meta,.service-hero-grid>p,.case-hero-grid>div:last-child{
    max-width:none;
    justify-self:stretch;
  }
}

/* Small mobile */
@media(max-width:620px){
  :root{--gutter:18px}
  .shell{width:calc(100% - var(--gutter) - var(--gutter))}
  .hero-grid,.service-hero-grid,.case-hero-grid{
    padding-top:104px;
    padding-bottom:var(--sp-5);
  }
  .hero-copy .display{max-width:none}
  .btn{min-height:44px}
  .scope-actions{flex-direction:column}
  .scope-actions .btn{width:100%}
}

.mb-work-head{margin-bottom:var(--sp-5)}


/* =========================================================
   FULL-CONTENT EDITORIAL SYSTEM
   Content expands; margins do not.
   ========================================================= */
.section-intro{
  display:grid;
  grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);
  gap:var(--content-gap);
  align-items:start;
}
.section-intro .copy{max-width:760px}
.editorial-grid{
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  gap:var(--grid-gap);
}
.editorial-main{grid-column:span 8}
.editorial-side{grid-column:span 4}
.rich-list{border-top:1px solid var(--line)}
.rich-item{
  display:grid;
  grid-template-columns:52px minmax(0,1fr);
  gap:var(--sp-3);
  padding:var(--sp-4) 0;
  border-bottom:1px solid var(--line);
}
.rich-item .num{font-size:11px;color:#657177;padding-top:var(--sp-0)}
.rich-item h3{margin:0;font-size:clamp(21px,2vw,30px);font-weight:500;letter-spacing:-.025em}
.rich-item p{margin:var(--sp-2) 0 0;color:var(--muted);line-height:1.68;max-width:66ch}
.quote-block{
  padding:var(--sp-6);
  border:1px solid var(--line);
  background:rgba(255,255,255,.24)
}
.dark .quote-block,.violet .quote-block{border-color:var(--line-dark);background:rgba(255,255,255,.035)}
.quote-block blockquote{
  margin:0;
  font-family:"Noto Serif Display",Georgia,serif;
  font-style:italic;
  font-size:clamp(28px,3.2vw,48px);
  line-height:1.12;
  letter-spacing:-.025em
}
.quote-block cite{display:block;margin-top:var(--sp-3);font-size:11px;color:var(--muted);font-style:normal}
.faq{border-top:1px solid var(--line)}
.faq-item{padding:var(--sp-4) 0;border-bottom:1px solid var(--line)}
.faq-item h3{font-size:18px;font-weight:500;margin:0 0 var(--sp-2)}
.faq-item p{color:var(--muted);line-height:1.7;margin:0;max-width:760px}
.proof-strip{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line)
}
.proof-strip>div{padding:var(--sp-4) var(--sp-3);border-right:1px solid var(--line)}
.proof-strip>div:first-child{padding-left:0}.proof-strip>div:last-child{border-right:0}
.proof-strip strong{display:block;font-size:20px;font-weight:500}
.proof-strip span{display:block;margin-top:var(--sp-1);font-size:12px;color:var(--muted)}
.full-bleed-note{
  width:100%;
  padding:var(--sp-6);
  background:var(--paper-2);
  border:1px solid var(--line)
}
.dark .full-bleed-note{background:rgba(255,255,255,.035);border-color:var(--line-dark)}
.related-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:var(--grid-gap)
}
.related-card{border-top:1px solid var(--line);padding-top:var(--sp-3);min-height:220px}
.related-card h3{font-size:24px;font-weight:500;letter-spacing:-.03em;margin:var(--sp-2) 0}
.related-card p{font-size:13px;color:var(--muted);line-height:1.6}
@media(max-width:900px){
  .section-intro{grid-template-columns:1fr}
  .editorial-main,.editorial-side{grid-column:1/-1}
  .proof-strip{grid-template-columns:repeat(2,1fr)}
  .proof-strip>div:nth-child(2){border-right:0}
  .proof-strip>div:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .related-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
  .proof-strip{grid-template-columns:1fr}
  .proof-strip>div{border-right:0!important;border-bottom:1px solid var(--line)}
  .quote-block,.full-bleed-note{padding:var(--sp-4)}
  .rich-item{grid-template-columns:38px 1fr}
}

/* Skip link: visible on keyboard focus only */
.skip-link{position:absolute;left:-9999px;top:0;z-index:2000;background:var(--ice);color:var(--navy);padding:var(--sp-1) var(--sp-2);border-radius:0 0 var(--radius) 0;font-size:13px}
.skip-link:focus{left:0}

/* =========================================================
   BORDER GLOW — signature "active intelligence" state
   The React Bits map calls for one authored glow treatment on active controls.
   Reuses the existing conic sweep; only appears on hover / focus / current state.
   ========================================================= */
.btn,.step-btn,.demo-btn,.tile{position:relative;isolation:isolate}
.btn:after,.step-btn.active:after,.demo-btn.active:after{
  content:"";position:absolute;inset:-1px;pointer-events:none;padding:1px;
  background:conic-gradient(from var(--glow-angle),transparent 0 18%,rgba(46,168,174,.95) 24%,rgba(33,99,175,.78) 31%,rgba(41,28,83,.75) 38%,transparent 46% 100%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  animation:glowSweep 6s linear infinite;opacity:0;transition:opacity .35s var(--ease)
}
.btn:hover:after,.btn:focus-visible:after,.step-btn.active:after,.demo-btn.active:after{opacity:1}
.btn-light:after{background:conic-gradient(from var(--glow-angle),transparent 0 18%,rgba(33,99,175,.9) 24%,rgba(41,28,83,.8) 32%,transparent 46% 100%)}
@media(prefers-reduced-motion:reduce){
  .btn:after,.step-btn.active:after,.demo-btn.active:after{animation:none}
  /* the scroll-expand card lands in its final state instead of tracking the scroll */
  .scroll-expand{transform:none!important;width:100%!important;max-width:none!important}
}

/* Visual carried inside the ScrollExpand island (kept from the previous stand-in) */
.rb-island--expand{height:150vh;position:relative}
.rb-island--expand .scroll-expand__content{display:block;height:100%}
.rb-island--expand .visual{
  position:absolute;inset:0;display:grid;place-items:center;color:var(--ice);
  background:radial-gradient(circle at 68% 28%,rgba(46,168,174,.30),transparent 27%),
             radial-gradient(circle at 35% 76%,rgba(41,28,83,.88),transparent 46%),
             linear-gradient(135deg,#0a1931,#102d4b 52%,#291c53)
}
.rb-island--expand .visual strong{font-size:clamp(40px,7vw,120px);letter-spacing:-.06em;font-weight:500}
/* React Bits islands keep their own geometry */
.rb-island{display:block}
.rb-island--ridges{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.rb-island--btn{display:inline-block}
/* Button islands: BorderGlow.css loads after this file with equal specificity, so these
   rules match its selector count to keep the component's 1px outline and stacked shadow
   off the buttons (they read as an empty box around the label). 2026-09-24 */
.rb-island.rb-island--btn .border-glow-card{display:inline-grid;width:auto;height:auto;padding:0;border:0;background:none;border-radius:0;box-shadow:none;overflow:visible}
.rb-island.rb-island--btn .border-glow-inner{padding:0;width:auto;display:inline-flex;overflow:hidden}
.rb-island.rb-island--btn .rb-children{display:inline-flex}
.rb-island--btn .btn{margin-top:0}
.rb-island--btn.mt-4{margin-top:var(--s-4,16px)}
.rb-island--btn.mt-5{margin-top:var(--s-5,24px)}
.rb-island--btn .border-glow-inner{padding:0;width:auto;overflow:hidden}  /* the component sets overflow:auto; it paints a scrollbar inside the button */
.rb-island--sidebar .line-sidebar{position:sticky;top:118px}
.rb-island--glass{display:block;min-height:260px}

/* ------------------------------------------------------------------
   Fixes found by looking at Lareesa's real window (660 css px): the effect
   was fighting the headline, the strip was crushed, and the mobile nav had
   no affordance.
   ------------------------------------------------------------------ */

/* 1. keep the hero type off the brightest part of the effect */
.hero .shell{position:relative;z-index:2}

/* 2. no hard seam where the effect is clipped at the hero's bottom edge */
.rb-island--ridges canvas{
  -webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 88%,transparent 100%);
          mask-image:linear-gradient(to bottom,#000 0%,#000 88%,transparent 100%);
}

/* 3. the button must not paint the component's overflow scrollbar */
.rb-island.rb-island--btn .border-glow-inner{overflow:hidden}

/* 4. one rhythm for every heading: the serif accent is a block on the same leading */
.h1 .serif,.h2 .serif,.h3 .serif,.display .serif{display:block;line-height:inherit;margin-top:.05em}
.h2{line-height:1.1}

/* 5. readable measure on narrow screens */
.section-intro .copy,.section-intro .lead,.section-intro>div>p{max-width:66ch}

/* 6. a real mobile menu control, aligned with the wordmark */
.mobile-menu{
  display:none;align-items:center;justify-content:center;gap:8px;
  border:1px solid rgba(225,238,240,.32);border-radius:999px;
  padding:0 var(--sp-2);min-height:38px;font-size:10.5px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--ice);background:rgba(225,238,240,.04)
}
.mobile-menu::before{content:"";width:12px;height:8px;border-top:1px solid currentColor;border-bottom:1px solid currentColor}

@media(max-width:900px){
  .mobile-menu{display:inline-flex}
  .section-intro .copy,.section-intro .lead,.section-intro>div>p{max-width:58ch}
  /* 7. the statement strip is four statements, not four squeezed columns */
  .statement-row{grid-template-columns:1fr 1fr}
  .statement-row div{padding:16px var(--sp-2)}
  .statement-row div:nth-child(2n){border-right:0}
  .statement-row div:nth-child(n+3){border-top:1px solid rgba(225,238,240,.14)}
  .hero-grid{padding-top:110px;gap:26px}
  .hero-actions{gap:var(--sp-2);margin-top:var(--sp-3)}
  .hero-actions .link{padding-bottom:2px}
}
@media(max-width:620px){
  .statement-row{grid-template-columns:1fr}
  .statement-row div:nth-child(n+2){border-top:1px solid rgba(225,238,240,.14)}
  .statement-row div{border-right:0}
  .stone .eyebrow,.stone .muted{color:#414d55}
}

/* ------------------------------------------------------------------
   Lift pass: the project cards were a gradient standing in for art
   direction, and the proof strip was four equal boxes with no hierarchy.
   ------------------------------------------------------------------ */
.project-media{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;
  z-index:0;transition:transform 1.4s var(--ease);filter:saturate(.96)
}
.project-card.has-media:before{
  inset:0;transform:none;z-index:1;   /* must paint above the cover, below the copy */
  /* two-axis scrim: light site captures carry white UI, so the text corner needs
     real darkness, not a hint of it */
  background:
    linear-gradient(0deg,rgba(4,12,22,.96) 0%,rgba(4,12,22,.86) 22%,rgba(4,12,22,.34) 52%,rgba(4,12,22,0) 78%),
    linear-gradient(90deg,rgba(4,12,22,.72) 0%,rgba(4,12,22,.30) 42%,rgba(4,12,22,0) 72%);
}
.project-card.has-media:hover:before{transform:none}
/* Case covers whose key line sits on the left of the source capture keep their left
   edge when the card crop is narrower than the image, so the headline stays legible. */
.project-media.media-left{object-position:left center}

/* Narrow cards put the copy across the middle of the cover, where a light site capture
   can still wash it out, so small cards carry an even scrim rather than a bottom fade. */
.project-card.small.has-media:before{
  background:
    linear-gradient(0deg,rgba(4,12,22,.97) 0%,rgba(4,12,22,.92) 34%,rgba(4,12,22,.72) 68%,rgba(4,12,22,.5) 100%),
    linear-gradient(90deg,rgba(4,12,22,.6) 0%,rgba(4,12,22,.2) 70%);
}

.project-card.has-media:hover .project-media{transform:scale(1.045)}
/* the card's trailing glyph was a corrupted escape (a stray control character plus
   "97"), never a real arrow — removed at the client's request */
.project-content h3{max-width:15ch}

/* the four proof points as an editorial path, not four tiles */
.proof-strip{grid-template-columns:repeat(4,1fr);gap:0;counter-reset:proof;border-top:1px solid rgba(10,25,49,.12)}
.proof-strip>div{
  counter-increment:proof;position:relative;padding:var(--sp-4) var(--sp-3) var(--sp-4) 0;
  border-right:1px solid rgba(10,25,49,.10);transition:background .45s var(--ease)
}
.proof-strip>div:last-child{border-right:0}
.proof-strip>div:before{
  content:"0" counter(proof);display:block;font-size:10.5px;font-weight:600;letter-spacing:.18em;
  color:#7a8790;margin-bottom:var(--sp-2);transition:color .45s var(--ease)
}
.proof-strip>div:after{
  content:"";position:absolute;left:0;top:-1px;width:0;height:2px;background:var(--blue);
  transition:width .5s var(--ease)
}
.proof-strip>div:hover:after{width:100%}
.proof-strip>div:hover:before{color:var(--blue)}
.proof-strip>div:hover{background:rgba(10,25,49,.02)}
.proof-strip strong{display:block;font-size:19px;font-weight:600;letter-spacing:-.015em;line-height:1.2}
.proof-strip span{display:block;margin-top:var(--sp-1);font-size:13.5px;line-height:1.6;color:var(--muted);max-width:30ch}
@media(max-width:900px){
  .proof-strip{grid-template-columns:1fr 1fr}
  .proof-strip>div{padding:24px var(--sp-2) var(--sp-3) 0}
  .proof-strip>div:nth-child(2n){border-right:0}
  .proof-strip>div:nth-child(n+3){border-top:1px solid rgba(10,25,49,.10)}
  .project-card{min-height:420px}
}
@media(max-width:620px){
  .proof-strip{grid-template-columns:1fr}
  .proof-strip>div{border-right:0;border-top:1px solid rgba(10,25,49,.10);padding:var(--sp-3) 0}
  .proof-strip>div:first-child{border-top:0}
}

/* ------------------------------------------------------------------
   Motion layer. Content is visible by default; the hidden start state is
   only applied once JS has initialised (html.has-motion), so a script
   failure can never leave the page blank. Reduced motion opts out.
   ------------------------------------------------------------------ */
html.has-motion .reveal{
  opacity:0;transform:translateY(22px);
  transition:opacity .9s var(--ease),transform .9s var(--ease);
  transition-delay:calc(var(--d,0) * 1ms)
}
html.has-motion .reveal.is-in{opacity:1;transform:none}
html.has-motion .reveal-media{will-change:transform}
@media(prefers-reduced-motion:reduce){
  html.has-motion .reveal{opacity:1;transform:none;transition:none}
}

/* ------------------------------------------------------------------
   work index — the full portfolio index. Cards that have no case page
   yet are records, not links: no ↗ affordance and no hover lift, so
   nothing looks clickable without going somewhere.
   ------------------------------------------------------------------ */
.work-index .project-card.full{grid-column:span 12}
.work-index .project-card.static{cursor:default}
.work-index .project-card.static .project-content:after{content:none}
.work-index .project-card.static:hover:before,
.work-index .project-card.static:hover .project-media{transform:none}
.work-index .project-card .eyebrow{max-width:46ch}
.work-index .project-card .project-content h3{max-width:20ch}


/* ------------------------------------------------------------------
   case template — styles for pages rendered by _build/render_case.py.
   Additive only: every rule below is scoped to .case-page / .case-* so
   the hand-built case page keeps the layout it was tuned for.
   ------------------------------------------------------------------ */
.case-page .case-hero{position:relative;overflow:hidden}
.case-page .case-hero .rb-island--ridges{z-index:0}
.case-page .case-hero-grid{position:relative;z-index:2}
.case-accent-rule{width:72px;height:2px;background:var(--case-accent,#2163af)}
.case-page .h1 .serif{color:var(--case-accent,#2163af)}
.case-page .eyebrow.muted{color:var(--case-accent-soft,#2ea8ae)}
.case-page .article-section h3{color:var(--case-accent,#2163af)}
.case-page .link,.case-page .related-card:hover h3{color:var(--case-accent,#2163af)}
.case-page .related-card{border-top-color:var(--case-accent,#2163af)}
.case-page .case-gallery figcaption{border-top-color:var(--case-accent,#2163af)}
.case-cover{margin:0;border:1px solid var(--line)}
.case-cover img{width:100%;height:auto;display:block}
.case-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--grid-gap)}
.case-gallery figure{margin:0;border:1px solid var(--line);background:rgba(255,255,255,.24)}
.case-gallery img{width:100%;height:auto;display:block;aspect-ratio:4/3;object-fit:contain;background:var(--paper-2)}
.case-scope-grid .rich-list{border-top:1px solid var(--line)}
@media(max-width:900px){
  .case-gallery{grid-template-columns:1fr}
}

/* case template polish: the gallery was unreadable at phone width, and the cover
   read as a raw screenshot rather than a framed artifact */
.case-frame{
  border:1px solid rgba(10,25,49,.12);border-radius:6px;overflow:hidden;
  box-shadow:0 24px 60px -30px rgba(10,25,49,.45)
}
.case-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sp-2)}
.case-gallery img{width:100%;height:auto;display:block}
@media(max-width:1100px){.case-gallery{grid-template-columns:1fr 1fr}}
@media(max-width:900px){
  .case-gallery{grid-template-columns:1fr;gap:var(--sp-2)}
  .case-actions{gap:var(--sp-2)}
}

/* the secondary hero action was blue-on-near-black — barely a button */
.case-hero .link,.case-hero .hero-actions .link{
  color:var(--ice);border-bottom:1px solid rgba(236,244,247,.55);padding-bottom:var(--sp-0)
}
.case-hero .link:hover{border-bottom-color:var(--ice)}

/* ------------------------------------------------------------------
   Landing visual lift: the page was desktop-width type with no imagery
   between the hero and the case cards. This is a moving strip of the real
   client work, built from the covers already in the repo.
   ------------------------------------------------------------------ */
.work-marquee{position:relative;overflow:hidden;border-top:1px solid rgba(10,25,49,.12);border-bottom:1px solid rgba(10,25,49,.12);background:var(--navy)}
.work-marquee:before,.work-marquee:after{
  content:"";position:absolute;top:0;bottom:0;width:90px;z-index:2;pointer-events:none
}
.work-marquee:before{left:0;background:linear-gradient(90deg,var(--navy),transparent)}
.work-marquee:after{right:0;background:linear-gradient(270deg,var(--navy),transparent)}
.work-marquee__track{display:flex;gap:var(--sp-2);padding:var(--sp-3) 0;width:max-content;animation:workScroll 48s linear infinite}
.work-marquee__item{margin:0;flex:0 0 auto;width:clamp(180px,22vw,300px)}
.work-marquee__item img{
  /* the covers are ~2:1 screenshots — a 16:10 frame cropped client headlines mid-word */
  display:block;width:100%;aspect-ratio:43/20;object-fit:cover;object-position:top left;
  border:1px solid rgba(225,238,240,.14);filter:saturate(.9) brightness(.92);
  transition:filter .5s var(--ease),transform .5s var(--ease)
}
.work-marquee__item:hover img{filter:none;transform:translateY(-3px)}
.work-marquee__item figcaption{
  margin-top:var(--sp-1);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(236,244,247,.78)
}
@keyframes workScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.work-marquee__track{animation:none}}
@media(max-width:900px){
  .work-marquee__track{gap:var(--sp-1);animation-duration:34s}
  .work-marquee__item{width:56vw}
}

/* ------------------------------------------------------------------

/* ---- audit fixes (2026-09-23) ------------------------------------------------
   Type floor: control labels and metadata were set at 10-11.5px, which put a large
   share of the page at the edge of comfortable reading size. Nav: the full link row
   fits with room to spare at 900px, so it only collapses when it genuinely runs out. */
.btn,.step-btn,.demo-btn{font-size:12.5px;letter-spacing:.10em}
.eyebrow,.hero .eyebrow,.service-hero .eyebrow,.case-hero .eyebrow,.section-intro .eyebrow{font-size:12px}
.footer-links a,.footer-bottom span,.meta-row span,.footer-grid p,.footer-grid a{font-size:12px}
body{font-size:16px}
@media(max-width:740px){
  .nav-inner{height:68px;grid-template-columns:1fr auto}
  .nav-links,.nav-end>a:not(.mobile-menu){display:none}
  .mobile-menu{display:block}
}

/* the menu button only exists once the links collapse, so it can never appear beside them */
@media(min-width:741px){.mobile-menu{display:none!important}}


/* ---- free audit: findings, gate, report links (added by apply_ai_and_fixes.py) ---- */
.audit-note{font-size:14.5px;color:var(--muted);margin:0 0 var(--sp-1)}
[data-audit-output][data-state="error"] .audit-note{color:#b4453f}
.audit-index{display:flex;align-items:baseline;gap:var(--sp-2);margin:var(--sp-1) 0 16px}
.audit-index b{font-size:clamp(38px,7vw,56px);line-height:1;font-weight:640;font-variant-numeric:tabular-nums}
.audit-index span{font-size:13px;color:var(--muted);max-width:30ch}
.audit-axis{display:grid;grid-template-columns:minmax(120px,160px) 1fr 42px;gap:var(--sp-1);align-items:center;
  padding:8px 0;border-bottom:1px solid var(--line);font-size:14px}
.audit-bar{display:block;height:6px;border-radius:99px;background:rgba(10,25,49,.08);overflow:hidden}
.audit-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--aqua))}/* --teal was never defined: the invalid colour stop killed the whole gradient, so no fill rendered */
.audit-axis b{text-align:right;font-weight:640}
.audit-finding{border:1px solid var(--line);border-radius:14px;padding:16px var(--sp-2);margin:var(--sp-2) 0}
.audit-finding h4{margin:0 0 var(--sp-1);font-size:15px}
.audit-finding .quote{border-left:3px solid var(--aqua);padding-left:var(--sp-1);font-style:italic;margin:8px 0}
.audit-finding .meta{font-size:13px;color:var(--muted)}
.audit-gate{display:grid;gap:8px;margin-top:var(--sp-2);max-width:460px}
.form-status[data-state="ok"]{color:var(--aqua)}
.form-status[data-state="error"]{color:#b4453f}
.proof-quote{border-left:3px solid var(--aqua);padding:var(--sp-0) 0 var(--sp-0) var(--sp-2);margin:0 0 8px}



/* case pages used an inline padding; it is a class now */
.case-open{padding:var(--sp-3) 0 var(--sp-5)}

/* the hero's facts column stopped 120px short of the container edge */
@media(min-width:901px){
  .hero-grid{grid-template-columns:minmax(0,1fr) minmax(280px,360px)}
  .hero-grid>.hero-meta{justify-self:stretch;max-width:none}
}

/* every control reaches the 44px touch-target minimum */
.nav-links a,.nav-end a,.footer-links a,.line-side a,.mobile-menu,.skip-link{min-height:44px}
@media(max-width:900px){
  .mobile-menu{min-height:44px;padding:0 16px}
}

/* spacing pass: applied by _build/snap_spacing.py */

/* case pages used an inline padding; it is a class now */
.case-open{padding:var(--sp-3) 0 var(--sp-5)}

/* the hero's facts column stopped 120px short of the container edge */
@media(min-width:901px){
  .hero-grid{grid-template-columns:minmax(0,1fr) minmax(280px,360px)}
  .hero-grid>.hero-meta{justify-self:stretch;max-width:none}
}

/* every control reaches the 44px touch-target minimum */
.nav-links a,.nav-end a,.footer-links a,.line-side a,.mobile-menu,.skip-link{min-height:44px}
@media(max-width:900px){
  .mobile-menu{min-height:44px;padding:0 16px}
}

/* short nav words reach the 44px hit area */
.nav-links a,.nav-end a{padding-inline:var(--sp-1)}
.nav-inner .nav-links{margin-inline:calc(var(--sp-1) * -1)}

/* sticky blocks only make sense in a two-column layout: when the layout collapses
   to one column (<=900px) the pinned heading covered the list beneath it. */
@media(max-width:900px){
  .service-layout .sticky,.case-layout .line-side,.line-side{position:static;top:auto}
  .service-layout{row-gap:var(--sp-6)}
  .case-layout{row-gap:var(--sp-6)}
}

/* spacing standard rule 13: text never sits on a rule the block owns */
.step-indicator-row{padding-top:var(--sp-1)}
.rb-edit-step__label{padding-bottom:var(--sp-1)}
.btn{padding-block:var(--sp-0)}

/* spacing standard rule 13, at the specificity the component rules use */
.rb-island--stepper .step-indicator-row{padding-top:var(--sp-1)}
.rb-island--stepper .rb-edit-step__label{padding-bottom:var(--sp-1)}
.btn{min-height:46px}



/* rule 13 overrides, specificity above the component sheets and the runtime island loader */
body .rb-island--stepper .step-indicator-row{padding-top:var(--sp-1)}
body .rb-island--stepper .rb-edit-step__label{padding-bottom:var(--sp-1)}
body .btn{min-height:46px;padding-block:var(--sp-0)}

/* the vertical rule between proof columns was sitting flush against the next
   column's text (0px). Give both sides of every rule real padding again. */
.proof-strip>div{padding-left:var(--sp-2);padding-right:var(--sp-2)}
@media(min-width:1101px){.proof-strip>div:first-child{padding-left:0}}
/* the two-column layout starts at 900px: below that the odd cells sit in column one and
   need no left padding. Between 901 and 1100 the strip is still four columns, where
   zeroing the odd cells put their text straight onto the neighbour's rule (0px gap). */
@media(max-width:900px){.proof-strip>div:nth-child(odd){padding-left:0}}
/* below 900px the stepper's labels are wider than their column, so the word
   overflowed into the next cell: let them fit */
@media(max-width:900px){
  body .rb-island--stepper .rb-edit-step__label{font-size:10px;letter-spacing:0;min-width:0}
  body .rb-island--stepper .rb-edit-step{padding-inline:var(--sp-0)}
}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}
.scope-left{position:relative;overflow:hidden}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}


/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* the shared hero background fills the header it sits in */
.hero,.service-hero,.case-hero,[data-hero-bg]{position:relative}

/* ==========================================================================
   EVIDENCE — real work inside the explanatory pages
   One component for proof imagery: a figure, a real caption, an optional link
   to the case study it comes from. Nothing ambient, nothing generated: if it
   does not prove, explain, demonstrate or humanise, it does not belong here.
   ========================================================================== */
.evidence{margin-top:var(--sp-5)}
.evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-3)}
.evidence-grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.evidence-grid.cols-1{grid-template-columns:minmax(0,1fr)}
.evidence-grid.wide-first>figure:first-child{grid-column:1/-1}
.evidence figure{margin:0;display:flex;flex-direction:column}
.evidence img,.evidence video{width:100%;height:auto;display:block;border:1px solid var(--line);background:var(--paper-2)}
.evidence-grid.fixed img{aspect-ratio:4/3;object-fit:cover}
.evidence-grid.devices img{aspect-ratio:16/10;object-fit:cover;object-position:top center}
.evidence-grid.marks img{aspect-ratio:16/9;object-fit:contain;padding:var(--sp-4);background:var(--navy);border-color:var(--line-dark)}
.evidence figcaption{margin-top:var(--sp-1);font-size:12.5px;line-height:1.7;color:var(--muted);max-width:64ch}
.evidence figcaption b{font-weight:600;color:var(--ink)}
.dark .evidence figcaption{color:rgba(225,238,240,.72)}
.dark .evidence figcaption b{color:var(--ice)}
.dark .evidence img,.dark .evidence video{border-color:var(--line-dark)}
.evidence figcaption a{color:inherit;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:1px}
.evidence-frame{display:grid;grid-template-columns:1.4fr minmax(0,1fr);gap:var(--sp-3);align-items:end}
.evidence-frame .evidence-note p{font-size:13.5px;line-height:1.9;color:var(--muted);max-width:34ch}

/* FLOW — a decision model as numbered cells, one rule between them */
.flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
.flow>div{background:var(--paper);padding:var(--sp-3)}
.flow b{display:block;font-size:11px;font-weight:700;letter-spacing:.14em;color:var(--blue);margin-bottom:var(--sp-2)}
.flow p{margin:0;font-size:13.5px;line-height:1.65;color:var(--ink)}
.flow small{display:block;margin-top:var(--sp-1);font-size:12px;line-height:1.6;color:var(--muted)}
.dark .flow{background:var(--line-dark);border-color:var(--line-dark)}
.dark .flow>div{background:var(--navy)}
.dark .flow p{color:var(--ice)}
.dark .flow small{color:rgba(225,238,240,.66)}
.stone .flow>div{background:var(--stone)}
@media(max-width:1000px){
  .evidence-grid,.evidence-grid.cols-3{grid-template-columns:repeat(2,minmax(0,1fr))}
  .evidence-frame{grid-template-columns:minmax(0,1fr)}
  .flow{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
  .evidence-grid,.evidence-grid.cols-3,.evidence-grid.cols-2{grid-template-columns:minmax(0,1fr)}
  .flow{grid-template-columns:minmax(0,1fr)}
}

/* A flow whose step count is not a multiple of the row size would leave an empty
   cell showing the 1px line colour — a solid block that reads as a missing step.
   These let the last row stretch to fill instead (7 = 4 + 3, 6 = 4 + 2, 5 = 4 + 1). */
.flow[data-count="5"],.flow[data-count="6"],.flow[data-count="7"]{grid-template-columns:repeat(12,minmax(0,1fr))}
.flow[data-count="5"]>div,.flow[data-count="6"]>div,.flow[data-count="7"]>div{grid-column:span 3}
.flow[data-count="5"]>div:nth-child(n+5){grid-column:span 12}
.flow[data-count="6"]>div:nth-child(n+5){grid-column:span 6}
.flow[data-count="7"]>div:nth-child(n+5){grid-column:span 4}
@media(max-width:1000px){
  .flow[data-count="5"],.flow[data-count="6"],.flow[data-count="7"]{grid-template-columns:repeat(2,minmax(0,1fr))}
  .flow[data-count="5"]>div,.flow[data-count="6"]>div,.flow[data-count="7"]>div{grid-column:auto}
  .flow[data-count="5"]>div:nth-child(n+5),.flow[data-count="6"]>div:nth-child(n+5),
  .flow[data-count="7"]>div:nth-child(n+5){grid-column:auto}
  .flow[data-count="5"]>div:last-child,.flow[data-count="7"]>div:last-child{grid-column:span 2}
}

/* =========================================================
   HOW WE COLLABORATE — numbered process rail (2026-09-25)
   One phase open at a time; the rail keeps the rest of the
   process visible. Replaces the React Bits Stepper island.
   ========================================================= */
.phase-rail{margin-top:var(--sp-5)}
.phase-track{display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-1);
  border-bottom:1px solid var(--line);padding-bottom:var(--sp-3);margin-bottom:var(--sp-5)}
.phase-stop{display:inline-flex;align-items:center;gap:11px;background:none;cursor:pointer;
  border:1px solid rgba(10,25,49,.16);border-radius:999px;padding:9px 15px;color:var(--ink);
  font:500 13px/1 Montserrat,Inter,sans-serif;transition:.35s var(--ease)}
.phase-stop:hover{border-color:var(--blue)}
.phase-stop .phase-num{font:600 11px/1 Inter,Arial,sans-serif;color:#1d7f85;letter-spacing:.06em}
.phase-stop .phase-name{color:inherit}
.phase-stop.is-on{background:var(--navy);border-color:var(--navy);color:#fff}
.phase-stop.is-on .phase-name{font-weight:600}
.phase-stop.is-on .phase-num{color:#7fd6da}
.phase-stop.is-on:after{content:"";width:6px;height:6px;border-radius:999px;background:#7fd6da;margin-left:1px}
.phase-panel{display:none}
.phase-panel.is-on{display:grid;grid-template-columns:minmax(0,132px) minmax(0,1fr);gap:var(--sp-5);
  animation:stepIn .65s var(--ease)}
.phase-big{font:500 clamp(34px,4vw,52px)/1 Montserrat,Inter,sans-serif;color:rgba(10,25,49,.5);letter-spacing:-.02em}
.phase-title{font-family:'Noto Serif Display',Georgia,serif;font-style:italic;font-weight:400;
  font-size:clamp(21px,2.3vw,31px);line-height:1.3;letter-spacing:0;margin:0 0 var(--sp-3);max-width:30ch}
.phase-body{font-size:15px;line-height:1.72;color:var(--muted);margin:0 0 var(--sp-3);max-width:64ch}
.stone .phase-body{color:#3d484e}
.phase-q{font:500 12.5px/1.55 Inter,Arial,sans-serif;color:var(--blue);margin:0;max-width:64ch}
@media(max-width:900px){
  .phase-panel.is-on{grid-template-columns:minmax(0,1fr);gap:var(--sp-2)}
  .phase-big{font-size:30px}
  .phase-stop{padding:8px 12px;font-size:12.5px}
}

/* =========================================================
   CLIENT PERSPECTIVE — one large calm quote (2026-09-25)
   Real quotes only, with a portrait and a case link where a case
   page exists. The client logo strip was removed on her instruction.
   ========================================================= */
.quote-stage{margin-top:var(--sp-5)}
.quote-body{min-height:clamp(200px,22vw,280px)}
.quote-panel{display:none}
.quote-panel.is-on{display:block;animation:stepIn .65s var(--ease)}
.quote-large{margin:0;font-family:'Noto Serif Display',Georgia,serif;font-style:italic;font-weight:400;
  font-size:clamp(20px,2.4vw,31px);line-height:1.38;letter-spacing:.005em;max-width:58ch;color:var(--ink);
  text-wrap:pretty}
.quote-who{display:flex;align-items:center;gap:var(--sp-2);margin-top:var(--sp-4)}
.quote-face{width:64px;height:64px;object-fit:cover;border-radius:999px;background:var(--stone);flex:0 0 auto}
.quote-who strong{display:block;font:500 16px/1.3 Montserrat,Inter,sans-serif}
.quote-who span{display:block;font-size:12.5px;color:var(--muted);margin-top:4px}
.quote-who a{display:inline-block;margin-top:7px;font:600 12.5px/1 Inter,Arial,sans-serif;color:var(--blue);
  border-bottom:1px solid rgba(33,99,175,.4);padding-bottom:2px;white-space:nowrap}
.quote-pick{display:flex;flex-wrap:wrap;gap:var(--sp-1);margin-top:var(--sp-5);
  border-top:1px solid var(--line);padding-top:var(--sp-3)}
.quote-thumb{display:inline-flex;align-items:center;gap:9px;background:none;cursor:pointer;
  border:1px solid rgba(10,25,49,.14);border-radius:999px;padding:5px 14px 5px 5px;color:var(--muted);
  font:500 12.5px/1 Montserrat,Inter,sans-serif;transition:.35s var(--ease)}
.quote-thumb img{width:28px;height:28px;border-radius:999px;object-fit:cover}
.quote-thumb:hover{border-color:var(--blue);color:var(--ink)}
.quote-thumb.is-on{background:var(--navy);border-color:var(--navy);color:#fff}
@media(max-width:620px){
  .quote-body{min-height:0}
  .quote-pick{gap:8px}
  .quote-thumb{padding:4px 10px 4px 4px;font-size:12px}
}
/* ---- chosen animated covers (27 Sep 2026)----------------------------------------------------
   The picked motion cover is a complete cover (plate and screen), so it replaces the card's own
   cover instead of stacking on it: the still fades out as the motion fades in, so exactly one
   screen is ever visible. On a studio card the swap happens inside the stage, never over the text. */
[data-cover-motion]{position:relative}
.cover-motion{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;
  transition:opacity .4s ease;pointer-events:none;z-index:2}
.studio-stage .cover-motion{position:absolute;inset:0}
[data-cover-motion] > .project-media,
[data-cover-motion] > img,
[data-cover-motion] .studio-scene{transition:opacity .4s ease}
[data-cover-motion]:hover > .project-media,
[data-cover-motion]:hover > img,
[data-cover-motion]:hover .studio-scene{opacity:0}
[data-cover-motion]:hover .cover-motion{opacity:1}
@media (prefers-reduced-motion:reduce){.cover-motion{display:none}}
@media (hover:none){.cover-motion{display:none}}
